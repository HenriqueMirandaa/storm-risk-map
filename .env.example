# Porta do servidor
PORT=3000

# live = dados reais (IPMA + Open-Meteo) | mock = tempestade simulada (desenvolvimento/demo)
DATA_MODE=live

# Intervalos de atualização (ms)
IPMA_POLL_MS=300000      # avisos IPMA: 5 min
WEATHER_POLL_MS=900000   # Open-Meteo: 15 min

# Horizonte dos avisos a considerar (horas à frente)
WARNING_WINDOW_H=24

# Nome da tempestade ativa (o IPMA nao o inclui no JSON de avisos; definido manualmente no MVP)
STORM_NAME=

# Chaves de API (separadas por virgula). Vazio = API aberta.
API_KEYS=

# Origem permitida em CORS (* = qualquer)
CORS_ORIGIN=*
